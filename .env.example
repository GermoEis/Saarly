# Kui need puuduvad, käivitub Saarly automaatselt demorežiimis.
EXPO_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY
EXPO_PUBLIC_APP_MODE=demo
# Muuda true-ks alles pärast Google provideri seadistamist Supabase'is.
EXPO_PUBLIC_GOOGLE_AUTH_ENABLED=false
# Päris turvakoodi ei tohi panna EXPO_PUBLIC muutujasse ega kliendirakendusse.
# Supabase'i režiimis määratakse kood administraatori vaates ja server hoiab ainult selle räsi.
